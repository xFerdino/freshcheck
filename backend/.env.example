MONGO_URL="mongodb://localhost:27017"
DB_NAME="freshcheck"
CORS_ORIGINS="http://localhost:3000"
TAVILY_API_KEY=tvly-your-tavily-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENAI_API_KEY=sk-your-openai-key
# Defaults: openai/gpt-4o-mini and openai/gpt-4o (or openrouter/nvidia/nemotron-3.5-lightning:free and openrouter/nvidia/nemotron-3.5-super-vl:free when OPENROUTER_API_KEY is set)
EXTRACT_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free
VERDICT_MODEL=openrouter/nvidia/nemotron-3.5-super-vl:free
BIFROST_BASE_URL=http://localhost:8080
BIFROST_API_KEY=
EMERGENT_LLM_KEY=sk-emergent-your-key-only-if-bifrost-unset
RATE_LIMIT_PER_10MIN=10
RUN_TIMEOUT_SECONDS=120
TRUSTED_PROXY_HOPS=0
